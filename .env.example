# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables) for the live site. Never commit real values.

# beehiiv: the Market Letter sign-up forms (app/actions/newsletter.ts).
# Create an API key in beehiiv under Settings → Workspace → API, with the subscriptions:write scope.
BEEHIIV_API_KEY=
# Your publication's ID, starting "pub_" (beehiiv Settings → Workspace → API, or the publication's URL).
BEEHIIV_PUBLICATION_ID=
