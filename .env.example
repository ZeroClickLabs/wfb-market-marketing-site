# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables) for the live site. Never commit real values.

# beehiiv: the Market Letter sign-up forms (app/actions/newsletter.ts).
# Create an API key in beehiiv under Settings → Workspace → API, with the subscriptions:write scope.
BEEHIIV_API_KEY=
# Your publication's ID, starting "pub_" (beehiiv Settings → Workspace → API, or the publication's URL).
BEEHIIV_PUBLICATION_ID=

# Google Analytics 4: your web stream's measurement ID, starting "G-"
# (Analytics → Admin → Data streams → your web stream). Read at build time, and analytics only
# runs on production builds, so set it in Vercel and redeploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vendor portal: Supabase (see docs/vendor-portal-setup.md). Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (starts "sb_publishable_"): safe in the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (starts "sb_secret_"): server only, bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Vendor portal email: Resend (resend.com → API Keys) and the verified sender address.
RESEND_API_KEY=
PORTAL_EMAIL_FROM="Whitefish Bay Farmers Market <vendors@wfbmarkets.org>"
# The site's own address, used in links inside emails (e.g. https://wfbmarkets.org; http://localhost:3000 locally).
NEXT_PUBLIC_SITE_URL=
# A long random string; Vercel Cron sends it to the attendance-reminder job.
CRON_SECRET=
